# ===== Режим VPS. Скопируйте в deploy/.env и заполните =====
BACKEND=server

# Домен, направленный A-записью на IP сервера. Caddy сам получит HTTPS-сертификат
DOMAIN=grades.example.kz
# Почта для Let's Encrypt (уведомления о сертификате)
ACME_EMAIL=

# Токен бота от @BotFather и ваш Telegram ID (@userinfobot)
BOT_TOKEN=
OWNER_ID=

# Длинная случайная строка: openssl rand -hex 32
SECRET_KEY=

# Сколько дней хранить ежедневные бэкапы ./backups
BACKUP_KEEP_DAYS=14
